{
  "name": "demoparser",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts scripts/*.test.ts",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "scrape:roster": "node --env-file-if-exists=.env --import tsx scripts/scrape-roster.ts",
    "scrape:schedule": "node --env-file-if-exists=.env --import tsx scripts/scrape-schedule.ts",
    "ingest:demos": "node --env-file-if-exists=.env --import tsx scripts/ingest-demos.ts",
    "faceit:sync": "node --env-file-if-exists=.env --import tsx scripts/faceit-sync.ts",
    "cache:revalidate": "node --env-file-if-exists=.env --import tsx scripts/revalidate-cache.ts",
    "test:cache": "node --import tsx scripts/cache-integration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@laihoe/demoparser2": "^0.42.0",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "fastest-levenshtein": "^1.0.16",
    "json5": "^2.2.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
