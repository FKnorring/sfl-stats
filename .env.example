## Faceit Data API server-side key.
## Generate one in Faceit's App Studio (API Keys panel), server-side key.
## Required by scripts/faceit-sync.ts (lib/faceit-client.ts).
FACEIT_API_KEY=

## Steam Web API key, for resolving steamid64 -> persona name / avatar.
## Generate one at https://steamcommunity.com/dev/apikey.
## Required by app/players/[steamid64]/page.tsx (lib/steam-client.ts).
## If unset, player pages render without an avatar.
STEAM_API_KEY=

## Database connection, read by lib/db/client.ts and drizzle.config.ts.
## Leave unset to use the local SQLite file at data/sfl.db (default for
## dev/test). To point at a hosted Turso database instead, set:
##   DATABASE_URL=libsql://<db-name>-<org>.turso.io
##   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
## See docs/adr/0003-hosted-db-turso-libsql-drizzle.md.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

## Shared cache namespace. Must match between app and ingestion machine.
## Omit this variable to use "FKnorring/sfl-stats".
## Use separate databases/secrets for preview versus production.
# CACHE_NAMESPACE=FKnorring/sfl-stats

## Optional deployed-cache notification after ingestion (configure BOTH).
## Secret: server-only, same value locally and in the target Vercel environment.
## URL: local ingestion environment only; direct HTTPS endpoint, no redirects.
## Hosted DATABASE_URL must match the deployed app. Never enable on file: runs.
## Notifications mark data stale; the first reload may still show old data.
## Update app/scripts before dropping the retired generation table (migration 0008).
# CACHE_REVALIDATION_SECRET=<strong-random-secret>
# CACHE_REVALIDATION_URL=https://<production-domain>/api/revalidate

## local | prod. "local" enables dev-only tools (/dev/zones) and shows
## Netlight heatmaps; anything else (or unset) behaves as prod.
## Set ENV=local only in your own untracked .env on your dev machine.
ENV=prod
