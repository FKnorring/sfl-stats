## Faceit Data API server-side key.
## Generate one in Faceit's App Studio (API Keys panel), server-side key.
## Required by scripts/faceit-sync.ts (lib/faceit-client.ts).
FACEIT_API_KEY=

## Steam Web API key, for resolving steamid64 -> persona name / avatar.
## Generate one at https://steamcommunity.com/dev/apikey.
## Required by app/players/[steamid64]/page.tsx (lib/steam-client.ts).
## If unset, player pages render without an avatar.
STEAM_API_KEY=

## Database connection, read by lib/db/client.ts and drizzle.config.ts.
## Leave unset to use the local SQLite file at data/sfl.db (default for
## dev/test). To point at a hosted Turso database instead, set:
##   DATABASE_URL=libsql://<db-name>-<org>.turso.io
##   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
## See docs/adr/0003-hosted-db-turso-libsql-drizzle.md.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
